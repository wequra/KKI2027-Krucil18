<?xml version="1.0"?>
<package format="3">
  <name>guidance_control</name>
  <version>0.1.0</version>
  <description>Guidance &amp; control (C++): waypoint follower, PID/pure pursuit</description>
  <maintainer email="tim@example.com">Tim Dagozilla</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>mavros_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>msgs</depend>

  <!-- Runtime dependencies used by asv_vision_guidance.launch.py. -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>mavros_bridge</exec_depend>
  <exec_depend>mavros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
