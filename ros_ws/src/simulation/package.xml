<?xml version="1.0"?>
<package format="3">
  <name>simulation</name>
  <version>0.1.0</version>
  <description>Konfigurasi simulasi Gazebo + ArduPilot SITL untuk testing tanpa kapal fisik</description>
  <maintainer email="tim@example.com">Tim Dagozilla</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>perception</exec_depend>
  <exec_depend>guidance_control</exec_depend>
  <exec_depend>mavros_bridge</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>mavros_msgs</test_depend>
  <test_depend>msgs</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
