{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImageMeta",
  "type": "object",
  "required": ["image_id", "kind", "ts_utc", "lat", "lon"],
  "additionalProperties": false,
  "properties": {
    "image_id": {"type": "string"},
    "kind": {"enum": ["surface", "underwater"]},
    "ts_utc": {"type": "string", "format": "date-time"},
    "lat": {"type": "number"},
    "lon": {"type": "number"},
    "detections": {"type": "array", "items": {"type": "object",
      "required": ["label", "confidence"],
      "properties": {"label": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}}}}
  }
}
