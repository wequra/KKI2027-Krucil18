# URL halaman WebRTC bawaan MediaMTX untuk surface camera.
# Browser membuka URL ini, jadi gunakan localhost jika MediaMTX berjalan
# di komputer GCS yang sama; gunakan IP GCS jika browser berada di komputer lain.
# Setelah Jetson mem-publish RTSP ke path "surface":
VITE_SURFACE_CAMERA_WEBRTC_URL=http://localhost:8889/surface
# Browser-side URL for the existing FastAPI image API.
VITE_GCS_API_URL=http://localhost:8000
