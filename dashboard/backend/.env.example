# ============================================================
# Dagozilla GCS Backend Environment Configuration
# ============================================================

# ======================
# Database
# ======================
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/asv_db

# ======================
# Jetson Authentication
# ======================
JETSON_API_KEY=test_key

# ======================
# InfluxDB
# ======================
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dagozilla_docker_token_2026
INFLUXDB_ORG=dagozilla-itb
INFLUXDB_BUCKET=asv_telemetry

# ======================
# MAVLink Configuration
# ======================

# Simulator Example
# USE_SIMULATOR=true
# MAVLINK_CONNECTION_STRING=udpin:0.0.0.0:14550

# Hardware Example (Jetson / Pixhawk)
USE_SIMULATOR=false
MAVLINK_CONNECTION_STRING=udpin:0.0.0.0:14550
MAVLINK_BAUDRATE=115200
